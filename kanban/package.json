{
  "name": "openspec-kanban-integration",
  "version": "1.0.0",
  "description": "OpenSpec to GitHub Kanban integration for Fowlgen Wars",
  "main": "src/electron/main.cjs",
  "scripts": {
    "start": "tsx src/scripts/main-orchestrator.ts",
    "sync": "tsx src/scripts/main-orchestrator.ts",
    "setup": "npx -y tsx install.ts",
    "setup:opensign": "git submodule add https://github.com/OpenSignLabs/OpenSign.git Opensign || git clone https://github.com/OpenSignLabs/OpenSign.git Opensign",
    "verify": "tsx src/scripts/VERIFY_SETUP.ts",
    "status": "tsx src/scripts/VIEW_STATUS.ts",
    "dashboard": "tsx src/scripts/generate-dashboard.ts",
    "app": "tsx src/server/server.ts",
    "app:open": "tsx src/server/server.ts --open",
    "dev": "tsx src/server/server.ts",
    "test": "node test-e2e.cjs",
    "test:e2e": "node test-e2e.cjs",
    "build:server": "esbuild src/server/server.ts --bundle --platform=node --format=esm --outfile=dist/server.js",
    "app:desktop": "npm run build:server && electron src/electron/main.cjs",
    "dist": "npm run build:server && electron-builder --win",
    "dist:portable": "npm run build:server && electron-builder --win portable",
    "dist:msi": "npm run build:server && electron-builder --win msi"
  },
  "keywords": [
    "openspec",
    "kanban",
    "github",
    "projects",
    "fowlgowwars"
  ],
  "author": "Fowlgen Wars Team",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=16.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "build": {
    "appId": "com.fowlgenwars.kanban",
    "productName": "Kanban Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/electron/**/*",
      "src/web/**/*",
      "src/config/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        },
        {
          "target": "msi",
          "arch": ["x64"]
        }
      ]
    },
    "msi": {
      "oneClick": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kanban Studio"
    }
  },
  "private": true
}
