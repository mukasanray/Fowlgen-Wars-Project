{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020"],
    "allowJs": true,
    "strict": true,
    "moduleResolution": "node",
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src/**/*", "install.ts"],
  "exclude": ["node_modules", "dist", "src/web"]
}