# Exemplo de configuração do OpenSign local (NÃO use estes valores em produção).
#
# O instalador gera kanban/.env.opensign.local automaticamente, com segredos
# aleatórios e permissão 0600, e preserva os valores existentes em reexecuções.
# Este arquivo serve apenas como referência do que é usado pelo Compose.
#
# Copie com:
#   cp kanban/env.opensign.example kanban/.env.opensign.local
#   chmod 600 kanban/.env.opensign.local

# Identidade do projeto (slug vira nome do banco/usuário no Compose opcional)
OPENSIGN_PROJECT_NAME=opensign-local
OPENSIGN_PROJECT_SLUG=opensign-local
OPENSIGN_DB_NAME=opensign-local
OPENSIGN_DB_USER=opensign-local
OPENSIGN_DB_PASSWORD=<gere-um-valor-aleatorio>

# Segredos do OpenSign — gere com: openssl rand -hex 16 (MASTER_KEY) e -hex 32
MASTER_KEY=<12+ caracteres alfanuméricos>
OPENSIGN_JWT_SECRET=<32 bytes em hex>
OPENSIGN_WEBHOOK_SECRET=<32 bytes em hex>

# Aplicação Parse
APP_ID=opensign
REACT_APP_APPID=opensign

# MongoDB (dentro da rede do Compose)
MONGODB_URI=mongodb://mongo:27017/opensign
DATABASE_URL=mongodb://mongo:27017/opensign

# URLs públicas (ajuste a porta se usar --opensign-port)
#
# O instalador recalcula HOST_URL/PUBLIC_URL/SERVER_URL/REACT_APP_SERVERURL
# toda vez que roda, nesta ordem de prioridade:
#   1) OPENSIGN_PUBLIC_BASE_URL (abaixo), se definido
#   2) detecção automática de GitHub Codespaces (CODESPACE_NAME +
#      GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN) -> https://<nome>-<porta>.<domínio>
#   3) http://localhost:<porta>
#
# Isso evita o bug clássico de Codespaces: o navegador acessa por HTTPS num
# domínio *.app.github.dev, mas o front-end do OpenSign tenta chamar a API em
# http://localhost — bloqueado por mixed content — e a tela de cadastro do
# admin (/addadmin) nunca carrega, ficando presa na tela de login.
#
# Só preencha OPENSIGN_PUBLIC_BASE_URL manualmente se usar domínio próprio,
# túnel (ngrok/Cloudflare) ou outro ambiente que não seja localhost/Codespaces.
# OPENSIGN_PUBLIC_BASE_URL=https://meu-dominio.exemplo.com
HOST_URL=http://localhost:3001
PUBLIC_URL=http://localhost:3001
SERVER_URL=http://localhost:3001/api/app
REACT_APP_SERVERURL=http://localhost:3001/api/app

# Armazenamento local e e-mail desabilitado (dev)
USE_LOCAL=true
NODE_ENV=production
SMTP_ENABLE=false

# API v1.1 (opcional). O self-host gratuito NÃO expõe /api/v1.1.
# Preencha somente com um token real do OpenSign cloud/enterprise.
# OPENSIGN_API_TOKEN=
# OPENSIGN_API_BASE_URL=https://app.opensignlabs.com/api/v1.1
# OPENSIGN_API_VERSION=v1.1

# Porta publicada no host (127.0.0.1) para o Caddy
OPENSIGN_HOST_PORT=3001
OPENSIGN_BIND_ADDR=127.0.0.1

# Perfil opcional "kanban" (rodar o Kanban em container em vez do host)
# KANBAN_HOST_PORT=3002
# KANBAN_BIND_ADDR=127.0.0.1
# OPENSIGN_INTERNAL_URL=http://caddy:3001
