{
  "name": "Fowlgen Wars — Kanban + OpenSign",
  "dockerComposeFile": "../docker-compose.dev.yml",
  "service": "kanban",
  "workspaceFolder": "/app",
  "forwardPorts": [3000, 3001, 5432, 6379],
  "portsAttributes": {
    "3000": {
      "label": "Kanban Studio",
      "onAutoForward": "openBrowser",
      "visibility": "public"
    },
    "3001": {
      "label": "OpenSign",
      "onAutoForward": "notify",
      "visibility": "public"
    },
    "5432": {
      "label": "PostgreSQL",
      "onAutoForward": "ignore"
    },
    "6379": {
      "label": "Redis",
      "onAutoForward": "ignore"
    }
  },
  "postCreateCommand": "bash .devcontainer/setup-codespace.sh",
  "postStartCommand": "bash .devcontainer/start-codespace.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-docker",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "formulahendry.auto-rename-tag",
        "christian-kohler.path-intellisense"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "editor.formatOnSave": true
      }
    }
  },
  "remoteEnv": {
    "NODE_ENV": "development",
    "OPENSIGN_JWT_SECRET": "opensign-dev-secret-change-in-prod"
  },
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  }
}
