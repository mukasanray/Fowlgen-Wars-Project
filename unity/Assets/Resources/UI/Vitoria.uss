.screen {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    background-color: rgb(20, 16, 5);
}

.gold-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(18, 14, 4, 0.75);
}

.panel {
    width: 560px;
    align-items: center;
    justify-content: center;
    padding-left: 40px;
    padding-right: 40px;
    padding-top: 36px;
    padding-bottom: 36px;
    background-color: rgba(28, 22, 10, 0.92);
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-left-color: rgb(255, 204, 51);
    border-right-color: rgb(255, 204, 51);
    border-top-color: rgb(255, 204, 51);
    border-bottom-color: rgb(255, 204, 51);
}

.title {
    color: rgb(255, 215, 64);
    font-size: 38px;
    -unity-font-style: bold;
    margin-bottom: 10px;
    -unity-text-align: middle-center;
}

.subtitle {
    color: rgb(240, 230, 200);
    font-size: 16px;
    margin-bottom: 22px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.reward-box {
    width: 100%;
    align-items: center;
    justify-content: center;
    padding-top: 14px;
    padding-bottom: 14px;
    margin-bottom: 24px;
    background-color: rgba(45, 34, 12, 0.85);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 215, 64, 0.6);
    border-right-color: rgba(255, 215, 64, 0.6);
    border-top-color: rgba(255, 215, 64, 0.6);
    border-bottom-color: rgba(255, 215, 64, 0.6);
}

.reward-title {
    color: rgb(255, 225, 120);
    font-size: 13px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.reward-value {
    color: rgb(255, 255, 255);
    font-size: 19px;
    -unity-font-style: bold;
}

.primary-button {
    width: 290px;
    height: 64px;
    font-size: 26px;
    -unity-font-style: bold;
    color: rgb(30, 20, 5);
    background-color: rgb(255, 195, 30);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    -unity-text-align: middle-center;
}

.primary-button:hover {
    background-color: rgb(255, 215, 70);
    scale: 1.03 1.03;
}

.primary-button:active {
    background-color: rgb(220, 165, 20);
    scale: 0.98 0.98;
}

.status {
    min-height: 24px;
    margin-top: 14px;
    color: rgb(255, 235, 160);
    font-size: 15px;
    -unity-text-align: middle-center;
    white-space: normal;
}
