.screen {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    background-image: resource("Image/Derrota");
    -unity-background-scale-mode: scale-and-crop;
    background-color: rgb(22, 7, 7);
}

.crimson-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(18, 5, 5, 0.78);
}

.panel {
    width: 560px;
    align-items: center;
    justify-content: center;
    padding-left: 40px;
    padding-right: 40px;
    padding-top: 36px;
    padding-bottom: 36px;
    background-color: rgba(28, 10, 10, 0.92);
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-left-color: rgb(210, 45, 45);
    border-right-color: rgb(210, 45, 45);
    border-top-color: rgb(210, 45, 45);
    border-bottom-color: rgb(210, 45, 45);
}

.title {
    color: rgb(240, 70, 70);
    font-size: 38px;
    -unity-font-style: bold;
    margin-bottom: 10px;
    -unity-text-align: middle-center;
}

.subtitle {
    color: rgb(225, 195, 195);
    font-size: 16px;
    margin-bottom: 22px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.reward-box {
    width: 100%;
    align-items: center;
    justify-content: center;
    padding-top: 14px;
    padding-bottom: 14px;
    margin-bottom: 24px;
    background-color: rgba(45, 12, 12, 0.85);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(210, 45, 45, 0.6);
    border-right-color: rgba(210, 45, 45, 0.6);
    border-top-color: rgba(210, 45, 45, 0.6);
    border-bottom-color: rgba(210, 45, 45, 0.6);
}

.reward-title {
    color: rgb(230, 140, 140);
    font-size: 13px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.reward-value {
    color: rgb(255, 255, 255);
    font-size: 19px;
    -unity-font-style: bold;
}

.primary-button {
    width: 290px;
    height: 64px;
    font-size: 26px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    background-color: rgb(185, 40, 40);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    -unity-text-align: middle-center;
}

.primary-button:hover {
    background-color: rgb(215, 55, 55);
    scale: 1.03 1.03;
}

.primary-button:active {
    background-color: rgb(155, 30, 30);
    scale: 0.98 0.98;
}

.secondary-button {
    width: 290px;
    height: 48px;
    margin-top: 10px;
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(255, 210, 210);
    background-color: rgba(65, 20, 20, 0.9);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(210, 45, 45, 0.6);
    border-right-color: rgba(210, 45, 45, 0.6);
    border-top-color: rgba(210, 45, 45, 0.6);
    border-bottom-color: rgba(210, 45, 45, 0.6);
    -unity-text-align: middle-center;
}

.secondary-button:hover {
    background-color: rgba(90, 28, 28, 0.95);
    scale: 1.02 1.02;
}

.secondary-button:active {
    background-color: rgba(45, 15, 15, 0.95);
    scale: 0.98 0.98;
}

.aux-button {
    width: 290px;
    height: 44px;
    margin-top: 10px;
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(220, 220, 225);
    background-color: rgba(35, 25, 25, 0.85);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(140, 110, 110, 0.4);
    border-right-color: rgba(140, 110, 110, 0.4);
    border-top-color: rgba(140, 110, 110, 0.4);
    border-bottom-color: rgba(140, 110, 110, 0.4);
    -unity-text-align: middle-center;
}

.aux-button:hover {
    background-color: rgba(55, 38, 38, 0.95);
    scale: 1.02 1.02;
}

.aux-button:active {
    background-color: rgba(25, 15, 15, 0.95);
    scale: 0.98 0.98;
}

.status {
    min-height: 24px;
    margin-top: 14px;
    color: rgb(255, 190, 190);
    font-size: 15px;
    -unity-text-align: middle-center;
    white-space: normal;
}
