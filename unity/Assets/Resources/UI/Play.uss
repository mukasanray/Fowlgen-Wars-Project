.screen {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: flex-end;
    padding-bottom: 56px;
    background-image: resource("Image/Play/bg-play");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgba(0, 0, 0, 0);
}

.overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0);
}

.wallet-bar {
    position: absolute;
    top: 24px;
    right: 28px;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 10px;
    padding-bottom: 10px;
    background-color: rgba(10, 18, 30, 0.90);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(245, 166, 35, 0.5);
    border-right-color: rgba(245, 166, 35, 0.5);
    border-top-color: rgba(245, 166, 35, 0.5);
    border-bottom-color: rgba(245, 166, 35, 0.5);
    flex-direction: row;
    align-items: center;
}

.wallet-info-group {
    flex-direction: column;
    align-items: flex-start;
    margin-right: 18px;
}

.wallet-actions-group {
    flex-direction: row;
    align-items: center;
}

.wallet-address {
    color: rgb(180, 200, 220);
    font-size: 13px;
    margin-bottom: 2px;
}

.wallet-balance {
    color: rgb(255, 204, 77);
    font-size: 18px;
    -unity-font-style: bold;
}

.aux-button-gold {
    height: 38px;
    padding-left: 14px;
    padding-right: 14px;
    margin-right: 8px;
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(25, 20, 5);
    background-color: rgb(255, 195, 30);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.aux-button-gold:hover {
    background-color: rgb(255, 215, 70);
    scale: 1.03 1.03;
}

.aux-button-gold:active {
    background-color: rgb(210, 155, 15);
    scale: 0.97 0.97;
}

.aux-button-danger {
    height: 38px;
    padding-left: 14px;
    padding-right: 14px;
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    background-color: rgba(180, 45, 45, 0.85);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.aux-button-danger:hover {
    background-color: rgb(215, 55, 55);
    scale: 1.03 1.03;
}

.aux-button-danger:active {
    background-color: rgb(150, 30, 30);
    scale: 0.97 0.97;
}

.panel {
    width: 720px;
    max-width: 90%;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
}

.title {
    color: rgb(255, 255, 255);
    font-size: 34px;
    -unity-font-style: bold;
    margin-bottom: 10px;
    -unity-text-align: middle-center;
}

.subtitle {
    color: rgb(205, 220, 235);
    font-size: 16px;
    margin-bottom: 28px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.primary-button {
    width: 700px;
    height: 100px;
    font-size: 35px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    background-color: rgb(52, 195, 38);
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-left-color: rgba(255, 230, 80, 0.6);
    border-right-color: rgba(255, 230, 80, 0.6);
    border-top-color: rgba(255, 230, 80, 0.6);
    border-bottom-color: rgba(255, 230, 80, 0.6);
    margin-bottom: 16px;
    -unity-text-align: middle-center;
    transition-property: scale, background-color, border-color;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

.primary-button:hover {
    background-color: rgb(78, 226, 62);
    border-left-color: rgb(255, 245, 110);
    border-right-color: rgb(255, 245, 110);
    border-top-color: rgb(255, 245, 110);
    border-bottom-color: rgb(255, 245, 110);
    scale: 1.05 1.05;
}

.primary-button:active {
    background-color: rgb(32, 145, 22);
    scale: 0.96 0.96;
}

.status {
    min-height: 24px;
    margin-top: 14px;
    color: rgb(255, 220, 145);
    font-size: 23px;
    -unity-text-align: middle-center;
    white-space: normal;
}
