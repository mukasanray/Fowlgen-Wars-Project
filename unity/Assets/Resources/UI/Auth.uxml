<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="screen" class="screen">
        <ui:VisualElement name="dark-overlay" class="overlay" />
        <ui:VisualElement name="login-panel" class="panel">
            <ui:Label text="FOWLGEN WARS" class="title" />
            <ui:Label text="Conecte sua carteira Phantom para iniciar a batalha" class="subtitle" />
            <ui:Button name="connect-button" text="Entrar" class="primary-button" />
            <ui:Label name="login-status" class="status" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
