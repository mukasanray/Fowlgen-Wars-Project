<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Resources/UI/Play.uss?fileID=7433441132597879392&amp;guid=5984428d1c12e234796d0d42f66b68cd&amp;type=3#Play"/>
    <ui:VisualElement name="screen" class="screen">
        <ui:VisualElement name="wallet-bar" class="wallet-bar" style="width: 469px;">
            <ui:VisualElement name="wallet-info-group" class="wallet-info-group" style="width: 206px;">
                <ui:Label name="wallet-address-label" text="Carteira: Conectando..." class="wallet-address" style="font-size: 17px;"/>
                <ui:Label name="wallet-balance-label" text="Saldo: -- SOL" class="wallet-balance" style="font-size: 20px;"/>
            </ui:VisualElement>
            <ui:VisualElement name="wallet-actions-group" class="wallet-actions-group">
                <ui:Button name="airdrop-button" text="+1 SOL Devnet" class="aux-button-gold"/>
                <ui:Button name="disconnect-button" text="Sair" class="aux-button-danger"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="play-panel" class="panel">
            <ui:Button name="play-button" text="BATALHAR AGORA" class="primary-button"/>
            <ui:Label name="play-status" class="status"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
