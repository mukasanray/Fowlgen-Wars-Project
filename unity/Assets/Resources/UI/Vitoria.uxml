<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="screen" class="screen">
        <ui:VisualElement name="gold-vignette" class="gold-overlay" />
        <ui:VisualElement name="victory-panel" class="panel">
            <ui:Label text="VITÓRIA ÉPICA!" class="title" />
            <ui:Label text="Você dominou as 3 rotas e destruiu o galinheiro inimigo!" class="subtitle" />
            <ui:VisualElement name="reward-box" class="reward-box">
                <ui:Label text="RECOMPENSAS DE CAMPEÃO" class="reward-title" />
                <ui:Label name="reward-details" text="+120 XP  |  +50 FOWL  |  +0.05 SOL" class="reward-value" />
            </ui:VisualElement>
            <ui:Button name="reward-button" text="Resgatar Recompensa On-Chain" class="primary-button" />
            <ui:Button name="explorer-button" text="Ver no Solana Explorer" class="secondary-button" />
            <ui:Button name="menu-button" text="Voltar ao Menu Principal" class="aux-button" />
            <ui:Label name="victory-status" class="status" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
