<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Resources/UI/Vitoria.uss?fileID=7433441132597879392&amp;guid=52a21af0262157b4ba86a78588572003&amp;type=3#Vitoria"/>
    <ui:VisualElement name="screen" class="screen">
        <ui:VisualElement name="victory-panel" class="panel">
            <ui:VisualElement name="reward-badge" class="reward-badge">
                <ui:Label text="RECOMPENSAS DE CAMPEÃO" class="reward-badge-header"/>
                <ui:Label name="reward-details" text="+120 XP   •   +50 FOWL   •   +0.05 SOL" class="reward-details"/>
            </ui:VisualElement>
            <ui:Button name="reward-button" text="Resgatar Recompensa On-Chain" class="primary-button"/>
            <ui:Button name="explorer-button" text="Ver no Solana Explorer" class="secondary-button"/>
            <ui:Button name="menu-button" text="Voltar ao Menu Principal" class="secondary-button"/>
            <ui:Label name="victory-status" class="status"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
